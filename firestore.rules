rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // مسار المزامنة الفورية لمنصة الخدمات والتجارة (fluent_platform_v2/main_state)
    match /fluent_platform_v2/{docId} {
      allow read, write: if true;
    }

    // مسارات احتياطية للمجموعات المنفصلة عند الحاجة
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
